{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Order",
  "type": "object",
  "required": ["order_id", "email", "items", "subtotal", "discount", "province", "tax", "total"],
  "additionalProperties": false,
  "properties": {
    "order_id": {"type": "string", "pattern": "^ORD-\\d+$"},
    "email": {"type": "string", "minLength": 3},
    "items": {"type": "array", "minItems": 1},
    "subtotal": {"type": "string", "pattern": "^\\d+\\.\\d{2}$"},
    "discount": {"type": "string", "pattern": "^\\d+\\.\\d{2}$"},
    "province": {"enum": ["AB", "BC", "ON", "QC"]},
    "tax": {"type": "string", "pattern": "^\\d+\\.\\d{2}$"},
    "total": {"type": "string", "pattern": "^\\d+\\.\\d{2}$"}
  }
}
